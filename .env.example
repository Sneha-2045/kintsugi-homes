# Example: Texas City, TX;Houston, TX;Austin, TX
AGENT_SYNC_LOCATIONS=
AGENT_SYNC_INTERVAL_DAYS=7
AGENT_SYNC_MIN_INTERVAL_HOURS=168
AGENT_ACTOR_ITEM_LIMIT=1000
